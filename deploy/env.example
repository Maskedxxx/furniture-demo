# Переменные деплоя furniture-demo. Скопировать в deploy/.env, chmod 600. .env в .gitignore.
PORT=8100                    # порт хоста (диапазон демо 8100–8199)
MEM_LIMIT=1g

# --- туннель tuna ---
TUNA_SUBDOMAIN=furniture-demo   # → https://furniture-demo.ru.tuna.am
TUNA_TOKEN=                  # поле token из ~/.config/tuna/tuna.yml на Spark
TUNA_EXTRA_ARGS=             # пусто: у приложения свой экран входа

# --- секреты приложения (раньше лежали в backend/.env) ---
OPENROUTER_API_KEY=
GEMINI_MODEL=google/gemini-3.1-flash-image-preview
